{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["WebWorker", "ES2023"],

    "outDir": "../dist/types/shared",

    "tsBuildInfoFile": "../dist/types/shared/tsconfig.tsbuildinfo",

    "rootDir": "../src/shared",

    // Shared files import each other with a .ts extension so Node can run the unit tests directly.
    "allowImportingTsExtensions": true,
    "emitDeclarationOnly": true
  },
  "include": ["../src/shared/**/*"],
  "exclude": ["../src/shared/**/*.test.ts"]
}
